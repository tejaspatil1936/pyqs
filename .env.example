# Copy to .env.local for local use. NEVER commit real values.

# --- Host site (MongoDB) ---
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/pyqs
NEXT_PUBLIC_PDF_BASE_URL=https://mitaoe-pyq-proxy.<your-subdomain>.workers.dev

# --- AI assistant (RAG) ---
# Neon Postgres connection string (pgvector must be available).
# Use the pooled "-pooler" URL on Vercel.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Comma-separated Gemini free-tier API keys (any count, 1..N). ALL keys are
# shared: the runtime rotates across every key per request (cooldown/bench on
# 429s) and the ingestion pipeline rotates over the same set. One key works;
# more keys raise both quotas.
GEMINI_API_KEYS=your-key-1,your-key-2,your-key-3

# Optional: override the Gemini model used for question extraction.
# Must be a model with free-tier quota (retired models report "limit: 0").
# GEMINI_MODEL=gemini-3.1-flash-lite
